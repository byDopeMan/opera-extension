{
  "manifest_version": 3,
  "name": "YouTube – Exaktes Upload-Datum",
  "version": "1.2.7",
  "update_url": "https://bydopeman.github.io/opera-extension/update.xml",
  "description": "Zeigt das genaue Hochladedatum statt ungenauer Angaben wie 'vor 1 Jahr' – direkt in Suche, Startseite, Kanal und Sidebar.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Exaktes Datum"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "https://bydopeman.github.io/*",
    "https://returnyoutubedislikeapi.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "options.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
